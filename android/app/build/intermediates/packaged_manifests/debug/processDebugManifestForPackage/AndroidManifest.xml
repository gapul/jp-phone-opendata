<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.gapul.jpphonedirectory"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="@string/app_name" >
        <activity
            android:name="net.gapul.jpphonedirectory.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The read permission must be BIND_DIRECTORY_SEARCH so that only the
            system Contacts Provider can bind to this, and the meta-data flag is
            how it discovers the directory in the first place.
        -->
        <provider
            android:name="net.gapul.jpphonedirectory.DirectoryProvider"
            android:authorities="net.gapul.jpphonedirectory.directory"
            android:exported="true"
            android:readPermission="android.permission.BIND_DIRECTORY_SEARCH" >
            <meta-data
                android:name="android.content.ContactDirectory"
                android:value="true" />
        </provider>
    </application>

</manifest>